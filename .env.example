# Server Port (Render sets this automatically in production)
PORT=3000

# Secret API Key protecting the /v1/profile endpoint
API_KEY=your_secret_api_key_here

# LinkedIn Playwright Storage State
# Can be a file path (e.g. session.json) or raw JSON string
LINKEDIN_STORAGE_STATE=session.json

# Maximum concurrent scraping tasks
MAX_CONCURRENT_SCRAPES=2

# Page navigation / scrape timeout in milliseconds
SCRAPE_TIMEOUT_MS=35000
