# Server Port (Render sets this dynamically in production)
PORT=3000

# Secret API Key protecting the /v1/profile endpoint
API_KEY=test-challenge-api-key-2026

# LinkedIn Session Cookie (li_at)
LINKEDIN_LI_AT=AQEDATe5bNwF0mdVAAABl...

# LinkedIn CSRF Session ID (JSESSIONID from browser cookies, e.g. ajax:1234567890123456789)
LINKEDIN_JSESSIONID=ajax:8273918273918273918
